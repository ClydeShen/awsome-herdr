    "git-merge": { "meaning": "the graph of commits", "labels": ["Show graph", "Show list"] },
    "git-fork": { "meaning": "all branches", "labels": ["Show all branches", "Show current branch"] },
    "tree-structure": { "meaning": "show as a tree", "labels": ["Show as tree", "Show as list"] },
    "arrows-clockwise": { "meaning": "refresh", "labels": ["Refresh"] },
    "prohibit": { "meaning": "ignore", "labels": ["Add to .gitignore"] },
    "paper-plane-right": { "meaning": "send to an agent", "labels": ["Send to agent"] },
    "pencil-simple": { "meaning": "rename", "labels": ["Rename"] },
    "pencil-simple-slash": { "meaning": "this file can't be edited here", "labels": ["Read-only on another machine", "Too large to edit"] },
    "text-indent": { "meaning": "the file's indentation", "labels": ["Indentation"] },
    "arrow-u-down-left": { "meaning": "wrap long lines", "labels": ["Wrap lines"] },
    "paint-brush": { "meaning": "appearance", "labels": ["Appearance\\u2026"] },
    "code": { "meaning": "the source text", "labels": ["Source"] },
    "amend": { "meaning": "amend the last commit", "labels": ["Amend"] },
    "commit": { "meaning": "commit", "labels": ["Commit"] },
    "close": { "meaning": "clear", "labels": ["Clear filter"] },
    "clock": { "meaning": "order by time", "labels": ["Priority", "Recent"] },
    "arrow-down-a-z": { "meaning": "order by name", "labels": ["Name"] },
    "grip-vertical": { "meaning": "order by hand", "labels": ["Manual"] },
    "layers": { "meaning": "group by space", "labels": ["Grouped by space"] },
    "git-branch": { "meaning": "group by main space (worktrees)", "labels": ["Grouped by main space"] },
    "tag": { "meaning": "group by name prefix", "labels": ["Grouped by prefix"] },
    "draft": { "meaning": "a draft pull request", "labels": ["Draft"] },

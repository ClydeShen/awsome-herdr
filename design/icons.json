{
  "$comment": "One icon, one meaning (docs/REQUIREMENTS.md §4.5b B5; docs/UI-LESSONS.md L16). Every action icon in the mods (a menu entry or a PaneButton with a label) is listed with its meaning and the labels that say it. scripts/ui-check.py C8 fails on an icon used with a label that isn't listed here, or an icon not listed at all: a new label means either the same meaning (add it) or a new meaning (pick another icon). `exception` records a second meaning the user accepted, with who and when.",
  "icons": {
    "eye": { "meaning": "see it in the preview column", "labels": ["Preview", "Rendered view"], "exception": "Rendered view (the preview column's Markdown view) also uses eye: user 2026-11-26 chose to keep it" },
    "tabs": { "meaning": "open it in a tab", "labels": ["Open in tab"] },
    "arrows-out-simple": { "meaning": "zoom: fill the work area, as Herdr's pane zoom (same shape as its zoom.svg)", "labels": ["Zoom"] },
    "arrows-in-simple": { "meaning": "exit zoom, as Herdr's pane unzoom (same shape as its unzoom.svg)", "labels": ["Exit zoom"] },
    "arrow-square-out": { "meaning": "leave Herdr: a system app or the browser", "labels": ["Open in default app", "Open on GitHub"] },
    "copy": { "meaning": "copy to the clipboard", "labels": ["Copy absolute path", "Copy relative path", "Copy full hash"] },
    "arrows-out-line-vertical": { "meaning": "expand vertically (the whole file)", "labels": ["Show full file", "Show changes only"] },
    "columns": { "meaning": "two columns side by side", "labels": ["Show side by side", "Show inline"] },
    "arrow-counter-clockwise": { "meaning": "back to how it was", "labels": ["Discard changes…", "Discard all changes…"] },
    "plus": { "meaning": "add", "labels": ["Stage changes", "Stage all changes", "New group\\u2026"] },
    "minus": { "meaning": "take out", "labels": ["Unstage changes", "Unstage all changes"] },
    "x": { "meaning": "close or remove", "labels": ["Close (Esc)", "Close preview", "Remove from group"] },

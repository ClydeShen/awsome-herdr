{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awsome Filetree mod.json",
  "description": "What Herdr reads from Awsome Filetree's mod.json, and the settings it takes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "frame": {
          "enum": [
            "none"
          ],
          "description": "\"none\": no frame around it."
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "up": {
              "title": "Up a folder",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.up",
              "x-section": "mod:awsome-filetree",
              "default": "ctrl-alt-backspace"
            },
            "into": {
              "title": "Into a folder",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.into",
              "x-section": "mod:awsome-filetree",
              "default": "ctrl-alt-enter"
            },
            "follow": {
              "title": "Follow the terminal again",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.follow",
              "x-section": "mod:awsome-filetree",
              "default": "ctrl-alt-home"
            },
            "menu": {
              "title": "Open the menu",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.menu",
              "x-section": "mod:awsome-filetree",
              "default": "shift-f10"
            },
            "rename": {
              "title": "Rename",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.rename",
              "x-section": "mod:awsome-filetree",
              "default": "f2"
            },
            "trash": {
              "title": "Move to Trash",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.trash",
              "x-section": "mod:awsome-filetree",
              "default": "delete",
              "x-default-macos": "cmd-backspace"
            },
            "undo": {
              "title": "Undo a new file or rename",
              "type": "string",
              "format": "key",
              "x-action": "awsome-filetree.undo",
              "x-section": "mod:awsome-filetree",
              "default": "ctrl-z",
              "x-default-macos": "cmd-z"
            }
          },
          "title": "Shortcuts"
        },
        "confirm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "delete": {
              "title": "Ask before moving to the Trash",
              "type": "boolean",
              "default": true
            }
          },
          "title": "Confirm"
        },
        "open": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preview": {
              "title": "Single-click",
              "description": "What a single click on a file does. Preview: show it in the preview column. Select only: just select it; double-click or Enter opens it in a tab.",
              "type": "string",
              "enum": [
                "slot",
                "off"
              ],
              "x-enum-labels": {
                "slot": "Preview",
                "off": "Select only"
              },
              "default": "slot"
            },
            "previewDelay": {
              "title": "Preview delay (ms)",
              "description": "How long a click waits for a second click before the preview column opens, so a double-click changes the layout once. Only while the column is hidden. 0 = no wait.",
              "type": "number",
              "minimum": 0,
              "default": 250
            }
          }
        },
        "row": {
          "type": "object",
          "additionalProperties": false,
          "title": "Rows",
          "properties": {
            "statusLetter": {
              "title": "Status letter",
              "description": "A file's Git status as a letter after its name. Off: the name's color says it.",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awsome Viewer mod.json",
  "description": "What Herdr reads from Awsome Viewer's mod.json, and the settings it takes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tree": {
              "title": "Tree refresh",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "10s"
            },
            "file": {
              "title": "File refresh",
              "type": [
                "string",
                "integer"
              ],
              "format": "duration",
              "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
              "default": "2s"
            }
          },
          "title": "Refresh"
        },
        "editors": {
          "title": "More editors",
          "description": "macOS app IDs, such as dev.zed.Zed.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fileManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "",
              "x-placeholder": "File manager"
            },
            "command": {
              "title": "Command",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [],
              "x-placeholder": "open -a Finder"
            }
          },
          "title": "File manager"
        },
        "gutter": {
          "title": "Changed lines",
          "description": "Off uses Herdr's editor, with selection and folding.",
          "type": "boolean",
          "default": false
        },
        "markdown": {
          "title": "Markdown opens as",
          "type": "string",
          "enum": [
            "preview",
            "code"
          ],
          "default": "preview"
        }
      }
    }
  }
}

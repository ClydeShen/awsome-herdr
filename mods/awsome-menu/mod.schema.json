{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awsome Menu mod.json",
  "description": "What Herdr reads from Awsome Menu's mod.json, and the settings it takes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's schema, for editors."
    },
    "version": {
      "type": "string",
      "description": "The mod's version."
    },
    "title": {
      "type": "string",
      "description": "The mod's name, as Herdr shows it."
    },
    "place": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "none"
      ],
      "description": "Where Herdr first docks the mod. \"none\": only where a layout or another mod puts it."
    },
    "size": {
      "type": "number",
      "minimum": 0,
      "description": "Its first size, in pixels."
    },
    "focusable": {
      "type": "boolean",
      "description": "Lets pane.go give a shown copy the keyboard."
    },
    "overlay": {
      "type": "object",
      "description": "How mod.open shows it.",
      "properties": {
        "kind": {
          "enum": [
            "dialog",
            "popup",
            "window"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "frame": {
          "enum": [
            "none"
          ],
          "description": "\"none\": no frame around it."
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Your changes. A setting left out uses its default.",
      "additionalProperties": false,
      "properties": {
        "terminals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hide": {
              "title": "Hidden terminals",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "x-placeholder": "Command Prompt"
            },
            "extra": {
              "title": "More terminals",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "x-placeholder": "Nushell: nu"
            }
          },
          "title": "Terminals"
        }
      }
    }
  }
}
